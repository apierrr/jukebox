# Copier en .env et adapter. Toutes les variables sont facultatives.

# Port publié sur l'hôte
PORT=8767
# Adresse de Lyrion Music Server (LMS)
LMS_URL=http://host.docker.internal:9000
# Lecteur LMS à piloter (adresse MAC affichée par LMS) ; vide = le premier trouvé
PLAYER_ID=
# Nom affiché dans l'app
APP_NAME=Jukebox
# Code demandé aux invités (chiffres) ; vide = accès libre.
# Lien magique qui connecte directement : https://<votre-domaine>/?pin=<code>
GUEST_PIN=
# Volume maximum atteignable depuis l'app (1-100)
MAX_VOLUME=80
# Clé de signature des cookies ; vide = générée dans data/secret.key
SECRET_KEY=

# --- Enceinte KEF LSX (facultatif) ---
# Réveil de l'enceinte avant une lecture, via kef-web-control
KEF_CONTROL_URL=
KEF_WAKE_WAIT=14
# Contrôle UPnP AVTransport de l'enceinte : le veilleur vérifie ce qu'elle joue
# réellement avant d'intervenir, ex. http://192.168.1.x:8080/AVTransport/ctrl
KEF_UPNP_URL=

# --- Recherche via l'API Qobuz (facultatif, ~5x plus rapide que via LMS) ---
# Identifiant d'application Qobuz ; le jeton utilisateur est lu dans un
# credentials.json {"user_auth_token": "..."} monté sur /qobuz/credentials.json
# (voir README). Sans ces deux éléments, la recherche passe par LMS.
QOBUZ_APP_ID=
